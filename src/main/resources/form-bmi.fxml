<?xml version="1.0" encoding="UTF-8"?>
<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.RadioButton?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.ToggleGroup?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<VBox xmlns="http://javafx.com/javafx/21" xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controller.BmiController" spacing="10.0"
      prefWidth="480.0" prefHeight="620.0"
      style="-fx-background-color: #f8fafc; -fx-font-family: 'SansSerif'; -fx-font-size: 14px;">
    <padding><Insets top="28" right="28" bottom="28" left="28"/></padding>
    <fx:define>
        <ToggleGroup fx:id="genderGroup"/>
    </fx:define>
    <children>
        <Label text="Kalkulator BMI" style="-fx-font-size: 26px; -fx-font-weight: bold; -fx-text-fill: #0f172a;"/>
        <Label text="Isi tinggi, berat, dan gender, lalu hitung." wrapText="true" style="-fx-text-fill: #64748b;"/>
        <Label text="Tinggi badan (cm)"/>
        <TextField fx:id="tinggiField" promptText="Contoh: 170"/>
        <Label text="Berat badan (kg)"/>
        <TextField fx:id="beratField" promptText="Contoh: 65"/>
        <Label text="Gender"/>
        <HBox spacing="20.0">
            <children>
                <RadioButton fx:id="priaRadio" text="Pria" toggleGroup="$genderGroup"/>
                <RadioButton fx:id="wanitaRadio" text="Wanita" toggleGroup="$genderGroup"/>
            </children>
        </HBox>
        <Label text="Underweight &lt; 90% • Normal 90–110% • Overweight &gt; 110%" wrapText="true"
               style="-fx-font-size: 12px; -fx-text-fill: #64748b;"/>
        <Button text="Hitung BMI" onAction="#hitung" defaultButton="true" maxWidth="Infinity"
                style="-fx-background-color: #2563eb; -fx-text-fill: white; -fx-font-weight: bold; -fx-padding: 12; -fx-background-radius: 8;"/>
        <Label fx:id="hasilLabel" text="Hasil perhitungan akan tampil di sini." wrapText="true" minHeight="95.0"/>
        <HBox alignment="CENTER">
            <children>
                <Label fx:id="kategoriLabel"/>
            </children>
        </HBox>
    </children>
</VBox>
